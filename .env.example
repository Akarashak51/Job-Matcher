# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already in .gitignore) - all values below are placeholders.

# --- Google Sign-In (optional) ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI: <your-deployed-url>/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Session signing (required in production) ---
# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# --- MongoDB Atlas (optional, enables cloud search history) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jobfinder

# --- Gemini AI layer (optional, enables AI re-ranking/digest/outreach drafts) ---
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
